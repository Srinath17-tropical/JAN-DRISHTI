# GEMINI_API_KEY: Server-side API key for Google Gemini LLM synthesis (POST /api/ai/agent).
# Optional for offline/evaluation runs: if omitted, the server automatically falls back
# to its deterministic Telangana spatial-statistical policy synthesis engine.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# PORT: HTTP port for the unified Express + Vite server (default: 3000)
PORT="3000"

# APP_URL: Public URL where the application is hosted
APP_URL="http://localhost:3000"
